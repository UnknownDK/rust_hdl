# Golden outputs are compared with the formatter's canonical LF output, even
# when the working tree otherwise uses CRLF (for example on Windows).
vhdl_lang/tests/formatting/*.vhd text eol=lf
# Preserve upstream whitespace in these unmodified input snapshots.
vhdl_lang/tests/formatting/corpus/**/*.vhdl text eol=lf whitespace=-blank-at-eol,-blank-at-eof
